# Copy to .env (never commit .env)
PORT=3000
# Judge agents run on 0G (the 0G Compute Router) by default: 0g | openai | anthropic
JUDGE_PROVIDER=0g
# 0G Compute Router key (https://pc.0g.ai/dashboard/api-keys). Also used for judge voice notes
# (whisper-large-v3) and the screenshot evidence step, whatever JUDGE_PROVIDER is.
ZG_API_KEY=
# ZG_BASE_URL=https://router-api.0g.ai/v1
# Optional overrides. On 0g the default model is 0gm-1.0-35b-a3b; gpt-5.4 also works.
# Claude models through 0G reject json_schema output, so don't use them for judges.
# JUDGE_MODEL=0gm-1.0-35b-a3b
# JUDGE_EFFORT=high
# Let a vision model on 0G read the live-test screenshots before judging (1 = on)
# JUDGE_EVIDENCE=0
# Anyone may re-judge a sample project on 0G from its page; total runs per day (each ~$0.007 on 0gm)
# PUBLIC_RUNS_PER_DAY=40
# To call OpenAI directly: JUDGE_PROVIDER=openai and set OPENAI_API_KEY (default model gpt-5.4)
# OPENAI_API_KEY=
# To use Claude directly: JUDGE_PROVIDER=anthropic and set ANTHROPIC_API_KEY (default model claude-opus-5-5)
# ANTHROPIC_API_KEY=
# Organizer key for judge and review routes. Unset = those routes are refused...
# ADMIN_TOKEN=
# ...unless you opt in for local development (direct, non-proxied localhost requests only):
ALLOW_LOCAL_ORGANIZER=1
# Browser origins allowed to call the API (comma-separated)
# CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Arkiv (Rabdi testnet): publish every judged run as read-only, expiring public records.
# Test wallet that writes; fund it with tGLM at https://hub.arkiv.network/faucet. Never a real wallet.
# ARKIV_PRIVATE_KEY=
# RPC access key from https://hub.arkiv.network/access-keys (without it: rate-limited public RPC)
# ARKIV_ACCESS_KEY=
# Read-only servers: the publisher address whose entities to show
# ARKIV_PUBLISHER=
# ARKIV_TTL_DAYS=120
# Swarm: the evidence bundle (review, dossier, live-test report and recordings) goes up here first.
# A Bee node that can upload (not ultra-light) and a postage stamp batch bought on it.
# BEE_URL=http://localhost:1633
# SWARM_BATCH_ID=
# SWARM_GATEWAY=https://api.gateway.ethswarm.org
