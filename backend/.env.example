# Copy to .env (never commit .env)
PORT=3000
# Judge agents run on 0G (the 0G Compute Router) by default: 0g | openai | anthropic
JUDGE_PROVIDER=0g
# 0G Compute Router key (https://pc.0g.ai/dashboard/api-keys). Also used for judge voice notes
# (whisper-large-v3) and the screenshot evidence step, whatever JUDGE_PROVIDER is.
ZG_API_KEY=
# ZG_BASE_URL=https://router-api.0g.ai/v1
# Optional overrides. On 0g the default model is 0gm-1.0-35b-a3b; gpt-5.4 also works.
# Claude models through 0G reject json_schema output, so don't use them for judges.
# JUDGE_MODEL=0gm-1.0-35b-a3b
# JUDGE_EFFORT=high
# Let a vision model on 0G read the live-test screenshots before judging (1 = on)
# JUDGE_EVIDENCE=0
# Anyone may re-judge a sample project on 0G from its page; total runs per day (each ~$0.007 on 0gm)
# PUBLIC_RUNS_PER_DAY=40
# To call OpenAI directly: JUDGE_PROVIDER=openai and set OPENAI_API_KEY (default model gpt-5.4)
# OPENAI_API_KEY=
# Fallback: with JUDGE_PROVIDER=0g and OPENAI_API_KEY set, a judge call that fails on 0G
# (balance empty, provider down, timeout) is retried on OpenAI. Public runs never fall back.
# JUDGE_FALLBACK=off
# JUDGE_FALLBACK_MODEL=gpt-5.4
# To use Claude directly: JUDGE_PROVIDER=anthropic and set ANTHROPIC_API_KEY (default model claude-opus-5-5)
# ANTHROPIC_API_KEY=
# Organizer key for judge and review routes. Unset = those routes are refused...
# ADMIN_TOKEN=pick-any-long-secret   # needed for the organizer page when you use the web app (it goes through the Vite proxy)
# ...unless you opt in for local development (direct, non-proxied localhost requests only):
ALLOW_LOCAL_ORGANIZER=1
# Browser origins allowed to call the API (comma-separated; * wildcards like https://*.vercel.app).
# Default: local dev/preview and every https://*.vercel.app. Add the web app's custom domain here.
# CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://*.vercel.app,https://arena.example.com
# Arkiv (Rabdi testnet): the arena's database. Every record (submissions, reviews, brackets...) is
# stored there, and judged runs are published as read-only public records. REQUIRED: the server
# won't start without it. Everything on Arkiv is public.
# Test wallet that writes; fund it with tGLM at https://hub.arkiv.network/faucet. Never a real wallet.
ARKIV_PRIVATE_KEY=
# Or reuse PUBLISHER_PRIVATE_KEY below as the Arkiv signing wallet. An access key alone cannot sign writes.
# RPC access key from https://hub.arkiv.network/access-keys (without it: rate-limited public RPC)
# ARKIV_ACCESS_KEY=
# Read-only servers: the publisher address whose entities to show
# ARKIV_PUBLISHER=
# ARKIV_TTL_DAYS=120
# Swarm: the evidence bundle (review, dossier, live-test report and recordings) goes up here first.
# A Bee node that can upload (not ultra-light) and a postage stamp batch bought on it.
# BEE_URL=http://localhost:1633
# SWARM_BATCH_ID=
# SWARM_GATEWAY=https://api.gateway.ethswarm.org

# --- Smart contracts (Base Sepolia test deployment). Switch all of these together to change chain.
CHAIN_ID=84532
CHAIN_NAME="Base Sepolia"
RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org
NATIVE_SYMBOL=ETH
TOKEN_ADDRESS=0x564B51f96406328Ad3dBD6E89b63219938F4fbb7
TOURNAMENT_MANAGER_ADDRESS=0x45cdb8fc0b250f70f56675e8b6c0c25ac6bd6c03
BETTING_POOLS_ADDRESS=0xb73e35494272ec09044893c585b40e0cedb7eb95
# Secrets. Use wallets made for this project, never a personal wallet.
# PUBLISHER_PRIVATE_KEY=
# Pays gas for automatic payouts. A wallet made only for this, with a little test ETH.
# RELAYER_PRIVATE_KEY=
# First block to read bets from (when BettingPools was deployed).
PAYOUTS_FROM_BLOCK=55244267

# --- World ID: one verified human can claim free FILTER once (see /wallet).
# From https://developer.world.org. The signing key is a secret and stays on this server.
# WORLD_APP_ID=app_xxxxx
# WORLD_RP_ID=rp_xxxxx
# WORLD_RP_SIGNING_KEY=
# staging = the World ID simulator (fake identities, for testing). production = the real World App.
# WORLD_ENVIRONMENT=staging
# Pays out the free FILTER. A new wallet made for this, holding FILTER and a little test ETH for gas.
# STARTER_PRIVATE_KEY=
# STARTER_AMOUNT=100

# --- Tournaments run themselves once the admin gives RELAYER_PRIVATE_KEY's wallet its roles (/organizer).
# The admin: sees Organizer and Judges, creates tournaments, gets the platform's 10% and decides
# the rare match that ties twice. Comma-separate several. Change it to hand over to a new admin,
# then restart. Empty means anyone with the contract's organizer role.
ADMIN_WALLET=0x4Fb38a974ABf6f3D6a1ffD048F792d37ddEF4b73
# How long betting stays open on each match, in minutes.
# AUTO_BETTING_MINUTES=10
# Set to 0 to stop new tournaments being created automatically.
# AUTO_TOURNAMENTS=1

# ---- 0G Storage: where every file is kept (uploads, demo videos, live-test recordings, screenshots) ----
# Records are in the Arkiv database (ARKIV_PRIVATE_KEY, required). Without 0G, uploads are refused.
ZG_STORAGE=1
# testnet (Galileo, chain 16602) | mainnet (16661)
# ZG_STORAGE_NETWORK=testnet
# Optional overrides (defaults follow the network; turbo indexer)
# ZG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
# ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# A DEDICATED server wallet that pays upload gas. Testnet only, fund it at https://faucet.0g.ai.
# Never reuse a personal key and never commit it. Everything uploaded is public and permanent.
# ZG_STORAGE_PRIVATE_KEY=
# Per-call timeout (ms); videos over this many MB are re-encoded smaller first; max file size (MB)
# ZG_STORAGE_TIMEOUT_MS=180000
# ZG_VIDEO_SHRINK_MB=40
# ZG_FILE_MAX_MB=300
# Memory for recently read files, so pages don't download from 0G every time (MB)
# ARKIV_FILE_CACHE_MB=256

# --- ENS (ENSv2 on Sepolia): every fighter and judge gets a name under ENS_PARENT.
# With ENS_PRIVATE_KEY set, the server registers the parent and issues all names by itself at startup.
# Use one server only: two servers on one wallet collide. Both wallets need Sepolia ETH (not Base Sepolia).
# ENS_PRIVATE_KEY=
# Optional: can write only the arena.* score records (Enhanced Access Control).
# ENS_WRITER_PRIVATE_KEY=
# ENS_PARENT=fightclub.eth
# ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The public site, written into each name's url and agent-endpoint[web] records.
# ARENA_PUBLIC_URL=
